rules_version = '2';
// Reglas de seguridad de Firestore (igual que el PCC4, solo la colección de usuarios).
// Se publican con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }
    function esAdmin() {
      return autenticado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function tienePerfil() {
      return autenticado() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Cada usuario lee su documento (rol y módulos); el admin lee y escribe todos.
    // Cualquier usuario registrado puede ver la lista (la usa el formulario de documentos
    // para elegir el responsable y a quién avisar del vencimiento).
    match /users/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if tienePerfil();
      allow write: if esAdmin();
    }

    // Todo lo demás, cerrado. Si un módulo nuevo guarda datos en Firestore, sumá su regla acá.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
