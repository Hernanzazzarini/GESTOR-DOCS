# Copiá este archivo como ".env" y completá los valores.
# El .env y el service-account.json NUNCA se suben a GitHub (están en .gitignore).

# Puerto local de la API
PORT=3000

# ID de la carpeta "Documentos generales" dentro de la Unidad compartida.
# Es lo que aparece al final de la URL al abrir la carpeta en Drive:
# https://drive.google.com/drive/folders/ESTE_ES_EL_ID
ROOT_FOLDER_ID=

# ID del proyecto de Firebase (el mismo que está en frontend/src/environments/environment.ts → projectId)
FIREBASE_PROJECT_ID=gestor-documentacion

# Ruta a la clave de la Service Account.
# En tu Mac: ./service-account.json   ·   En Render: /etc/secrets/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Desde qué direcciones se puede usar la API (separadas por coma, sin / al final)
ORIGENES_PERMITIDOS=http://localhost:4200,https://gestor-documentacion.web.app,https://gestor-documentacion.firebaseapp.com
